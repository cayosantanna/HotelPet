<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
  <persistence-unit name="exemplo-jpa" transaction-type="RESOURCE_LOCAL">
    <!-- Lista de todas as classes de entidade -->
    <class>model.Cliente</class>
    <class>model.Funcionario</class>
    <class>model.HistoricoRh</class>
    <class>model.HistoricoReserva</class>
    <class>model.Pagamento</class>
    <class>model.Pet</class>
    <class>model.RelatorioFuncionario</class>
    <class>model.Reserva</class>
    <class>model.ConfirmaçãoReserva</class>
    <properties>
      <!-- Propriedades de conexão com o banco de dados -->
      <property name="javax.persistence.jdbc.url" value="jdbc:mysql://hotelpetserver.mysql.database.azure.com:3306/hotelpet?useSSL=true&amp;requireSSL=true&amp;serverTimezone=UTC"/>
      <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="javax.persistence.jdbc.user" value="hotelpet"/>
      <property name="javax.persistence.jdbc.password" value="Hotel123456789"/>
      <!-- Propriedades do Hibernate -->
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.connection.pool_size" value="5"/>
      <property name="hibernate.id.new_generator_mappings" value="true"/>
      <property name="hibernate.jdbc.time_zone" value="UTC"/>
      <!-- Configuração do provedor JPA -->
      <property name="hibernate.archive.autodetection" value="class"/>
      <property name="hibernate.provider" value="org.hibernate.jpa.HibernatePersistenceProvider"/>
    </properties>
  </persistence-unit>
</persistence>
