<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="exemplo-jpa" transaction-type="RESOURCE_LOCAL">
    <!-- Lista de todas as classes de entidade -->
    <class>model.Cliente</class>
    <class>model.Funcionario</class>
    <class>model.HistoricoRh</class>
    <class>model.HistoricoReserva</class>
    <class>model.Pagamento</class>
    <class>model.Pet</class>
    <class>model.Relatorio</class>
    <class>model.RelatorioFuncionario</class>
    <class>model.Reserva</class>

    <properties>
      <!-- Propriedades de conexão com o banco de dados -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost/hotel_pet_db?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"/>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.user" value="HotelPet"/>
      <property name="jakarta.persistence.jdbc.password" value="123456789"/>

      <!-- Propriedades do Hibernate -->
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.connection.pool_size" value="5"/>
      <property name="hibernate.id.new_generator_mappings" value="true"/>
      <property name="hibernate.jdbc.time_zone" value="UTC"/>
    <property name="hibernate.archive.autodetection" value="class, hbm"/>

      <!-- Configurações de cache -->
      <property name="hibernate.cache.use_second_level_cache" value="false"/>
      <property name="hibernate.cache.use_query_cache" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
