            <Container class="javax.swing.JScrollPane" name="jScrollPane1">
              <AuxValues>
                <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
              </AuxValues>

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea1">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="14" style="0"/>
                    </Property>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="O servi&#xe7;o de banho &#xe9; essencial para a higiene e sa&#xfa;de dos pets. .&#xa;Inclui: &#xa;Lavagem Completa:Uso de shampoos e condicionadores espec&#xed;ficos para cada tipo de &#xa;pelagem e pele do animal. &#xa;Produtos hipoalerg&#xea;nicos e naturais s&#xe3;o uma boa op&#xe7;&#xe3;o.  &#xa;Secagem: Secagem com toalhas macias e secadores ajustados para n&#xe3;o assustar ou causar&#xa;desconforto ao pet. &#xa;Higiene dos Ouvidos: Limpeza cuidadosa dos ouvidos para evitar infec&#xe7;&#xf5;es. &#xa;Corte de Unhas: Corte de unhas para evitar desconforto e les&#xf5;es."/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
            <Container class="javax.swing.JScrollPane" name="jScrollPane2">
              <AuxValues>
                <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
              </AuxValues>

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea2">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="14" style="0"/>
                    </Property>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="A tosa &#xe9; mais do que apenas est&#xe9;tica; ajuda na manuten&#xe7;&#xe3;o da sa&#xfa;de da pele e pelagem. &#xa;Inclui:&#xa;Tosa Completa: Corte de pelagem de acordo com a ra&#xe7;a e necessidade do pet, incluindo tosas higi&#xea;nicas e est&#xe9;ticas.  &#xa;Desembara&#xe7;amento: Remo&#xe7;&#xe3;o de n&#xf3;s e pelos embara&#xe7;ados que podem causar desconforto e problemas de pele.&#xa;Hidrata&#xe7;&#xe3;o: Tratamentos com m&#xe1;scaras hidratantes para manter a pelagem macia e brilhante."/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
            <Container class="javax.swing.JScrollPane" name="jScrollPane3">
              <AuxValues>
                <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
              </AuxValues>

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea3">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="14" style="0"/>
                    </Property>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Os passeios s&#xe3;o fundamentais para o bem-estar f&#xed;sico e mental dos pets. &#xa;Inclui:  &#xa;Passeios Di&#xe1;rios: Caminhadas regulares em &#xe1;reas seguras e apropriadas, permitindo que os&#xa;pets explorem e se exercitem.  &#xa;Atividades Interativas: Jogos e atividades l&#xfa;dicas durante os passeios para estimular a mente e o corpo dos pets.  &#xa;Monitoramento Constante: Supervis&#xe3;o por profissionais qualificados para garantir a seguran&#xe7;a e o bem-estar durante os passeios."/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
            <Container class="javax.swing.JScrollPane" name="jScrollPane4">
              <AuxValues>
                <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
              </AuxValues>

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea4">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="SansSerif" size="14" style="0"/>
                    </Property>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="A alimenta&#xe7;&#xe3;o especial garante que os pets recebam a nutri&#xe7;&#xe3;o adequada &#xe0;s suas &#xa;necessidades individuais. &#xa;Inclui:  &#xa;Dieta Personalizada: Refei&#xe7;&#xf5;es preparadas de acordo com as necessidades diet&#xe9;ticas &#xa;espec&#xed;ficas, como alergias, intoler&#xe2;ncias e prefer&#xea;ncias alimentares.  &#xa;Ingredientes de Qualidade: Uso de ingredientes frescos e de alta qualidade, livres de aditivos &#xa;e conservantes artificiais.  &#xa;Consultas Nutricionais: Acompanhamento por nutricionistas veterin&#xe1;rios para garantir que a &#xa;dieta esteja balanceada e adequada."/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
